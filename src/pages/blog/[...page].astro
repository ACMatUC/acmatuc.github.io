---
import type { GetStaticPaths, Page } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "$layouts/Layout.astro";
import Pagination from "$components/Pagination.astro";
import BlogPostCard from "./_Post.astro";

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection("blog");
  posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(posts, { pageSize: 10 });
};

const { page } = Astro.props;
---

<Layout title={page.currentPage === 1 ? "Blog" : `Page ${page.currentPage} - Blog`}>
  <main class="blog-index">
    <header class="blog-intro">
      <h1>Ideas from the ACM<span class="brand-accent"><span class="brand-at">@</span>UC</span> community</h1>
      <p class="blog-deck">Stories, tutorials, and perspectives from across our computing community.</p>
    </header>

    {page.data.length === 0 ? (
      <p class="blog-empty">No posts yet. Check back soon for stories from the ACM@UC community.</p>
    ) : (
      <section aria-label="Blog posts" class="blog-posts">
        <div class="blog-section-heading">
          <h2>{page.currentPage === 1 ? "Recent posts" : `More posts · Page ${page.currentPage}`}</h2>
        </div>
        {page.data.map((post) => <BlogPostCard post={post} />)}
        <Pagination {page} className="blog-pagination" />
      </section>
    )}
  </main>
</Layout>
