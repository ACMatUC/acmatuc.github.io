---
import type { CollectionEntry } from "astro:content";
import BlogTag from "./_Tag.astro";
import { ExportOutlined } from "@ant-design/icons";
import { Image } from "astro:assets";

interface Props {
  post: CollectionEntry<"blog">;
}

const post = Astro.props.post;
const { title, image, author, date, tags, synopsis } = post.data;
const href = `/blog/${post.id}`;
---

<article class="blog-card">
  {image && (
    <a class="blog-card-image" href={href} aria-label={`Read ${title}`}>
      <Image src={image} alt={title} class="blog-card-photo" />
    </a>
  )}
  <div class="blog-card-copy">
    <p class="blog-card-meta">
      <time datetime={date.toISOString()}>{date.toLocaleDateString("en-US", { timeZone: "UTC", month: "long", day: "numeric", year: "numeric" })}</time>
      <span aria-hidden="true">/</span>
      <span>{author}</span>
    </p>
    <h3><a href={href}>{title}</a></h3>
    <p class="blog-card-synopsis">{synopsis}</p>
    <div class="blog-card-bottom">
      <div class="blog-card-tags" aria-label="Topics">
        {tags.map((tag: string) => <BlogTag tag={tag} />)}
      </div>
      <a class="blog-read-link" href={href}>Read story <ExportOutlined /></a>
    </div>
  </div>
</article>
